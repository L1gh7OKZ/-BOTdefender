# Configuration BOTdefender
PORT=3000
HOST=0.0.0.0

# Token de bot Discord (Optionnel pour l'analyse Snowflake, Recommandé pour l'API Discord complète)
# Obtenez votre token sur https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Identifiant client Discord (Application ID) pour l'enregistrement des commandes slash
DISCORD_CLIENT_ID=

# Préfixe pour les commandes textuelles du bot
BOT_PREFIX=!
